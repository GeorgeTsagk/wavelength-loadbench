# Tunables for one epoch. Changing these breaks comparability with prior
# epochs, so record the change: bump SCHEMA_NOTE and note it in the commit.
#
# v2 (2026-08-31): fresh network, per user decision after the v1 dust
# death-spiral. v1 paid 2-5k sat per payment, which mints vtxos below the
# ~3,950 sat fixed per-vtxo refresh fee (onchain share 3850 + margin 100);
# by epoch 14 every client held 27-52 terminally-unrefreshable dust vtxos
# and the whole fleet rejected refresh quotes ("insufficient_residual").
# v2 funds each client 2M sat (operator caps raised to admit that) and pays
# 25-100k per payment, so a received vtxo survives multiple refreshes.
# The 13 v1 epochs were discarded per user instruction.
#
# v4 (2026-09-03): rebuilt on both repos' MASTERS instead of release tags,
# to test whether the v3 findings are already fixed upstream. lumos
# master@efa4deb5 (290 commits past v0.1.0), wavelength main@e03e9d7c (257
# past v0.1.1). Directly relevant upstream work: "oor: postpone over-cap
# incoming admissions" and "oor: replace the self-transfer retry hack with
# postpone" (v3's dropped incoming transfers, invisible_sat), "round+db:
# retire dead rounds and give the deposit back" (v3's stuck queued refresh
# intents that locked 12.9M in pending_out), "oor: Scope the spend-input
# release to its reservation" (v3's stale live-vtxo set that jammed one
# client's coin selector), plus VTXO value-conservation enforcement.
# v3 ended at 74 epochs having swept 7.6M sat (22% of deposits) away from
# users; its data is kept in git history.
#
# v3 (2026-09-01): fresh network from epoch 0 with the polished harness
# (pass-only latency percentiles, per-board deposit amounts, measured
# profiling overhead <1%: see data/profiling-overhead.txt). Same workload
# and policy as v2.1; earlier series discarded per user instruction.
#
# v2.1 (2026-08-31, was epoch 14+ of the discarded v2): realistic refresh policy. v2 refreshed
# every client's whole fleet every epoch, which no real wallet does; it
# re-fronted ~19M sat of operator capital per epoch, drained user balances
# through fees, and by ~30 vtxos/client drowned the daemons in round churn
# (epochs 9-12: RPC deadline-exceeded sends, partial refreshes, a 5M sat
# queued-refresh backlog). v2.1 refreshes only vtxos a real wallet would:
# near batch expiry, or with a deep OOR lineage (which would otherwise hit
# the operator's 25k vB lineage cap mid-payment, the other v1/v2 send
# failure). Send RPC timeouts were also raised.
SCHEMA_NOTE="v4"

# --- versions under test ---
#
# Pinned to release tags, deliberately (see the playbook: re-pin consciously,
# never track a branch). The operator repo (lightninglabs/lumos) is PRIVATE:
# its source, patches against it, and symbolised operator profiles must never
# land in this public repo. The client repo (lightninglabs/wavelength) is
# public.
#
# lumos v0.1.0  = a525b060 (2026-07-20), latest operator tag.
# wavelength v0.1.1 = 2e89c924 (2026-08-06), latest stable client release.
#
# What actually runs is tag + one commit: bench/patch-pprof.sh adds the
# exact-bracket CPU profile handlers on a local branch `bench-pprof` in each
# checkout (lumos ba80830f, wavelength dc4a6637). The lumos branch must never
# be pushed anywhere: the repo is private.
# Local checkouts the images build from (source stays outside this repo):
LUMOS_SRC=/workspace/lumos
LUMOS_REV=e36c3fdb
LUMOS_BASE_TAG=master@efa4deb5
LUMOS_IMAGE=lumosd:wavebench
WAVELENGTH_SRC=/workspace/worktrees/wavelength-bench-v011
WAVELENGTH_REV=27f61739
WAVELENGTH_BASE_TAG=main@e03e9d7c
WAVED_IMAGE=waved:wavebench

# Support images. All already present locally; pinned tags.
BITCOIND_IMAGE=lightninglabs/bitcoin-core:29
ELECTRS_IMAGE=mirror.gcr.io/mempool/electrs:latest
LND_IMAGE=mirror.gcr.io/lightninglabs/lnd:daily-testing-20260701
PG_IMAGE=postgres:16-alpine

# --- topology ---
#
# 1 operator (lumosd, postgres backend so pg_stat_statements can attribute
# db time), 10 clients (waved, lwwallet + sqlite: the realistic client
# config, same engine the browser wallet runs on). One lnd is the operator's
# on-chain wallet; clients do not run lnd. electrs serves the Esplora API
# the lwwallet chain source requires.
NUM_CLIENTS=10

# --- profiling rates ---
#
# Both daemons expose these as flags (no patch needed, unlike tapd).
# 100us block sampling captures db and network waits while ignoring
# scheduler noise; mutex keeps 1 in 100 contention events. The reference
# instance measured this plus an active CPU profile at under 1% overhead.
BLOCK_PROFILE_RATE=100000
MUTEX_PROFILE_FRACTION=100

# --- mining policy ---
#
# Regtest with harness-controlled mining only. Nothing mines in the
# background: cases mine on demand while polling for confirmations
# (boarding confs, round confirmation), and each epoch additionally
# advances the chain by a fixed amount so batch-expiry pressure is a
# deterministic function of the epoch count.
#
# Real-world pacing: one epoch fires every 3 hours, which is 18 blocks at
# mainnet's 10-minute cadence, so the fixed advance is exactly that (plus a
# handful of on-demand confirmation blocks while cases wait). lumosd sweeps
# a batch 1008 blocks (one real week) after its round confirms, which lands
# ~45 epochs (~5.6 days of wall time) later: close to real time by
# construction.
MINE_BLOCKS_PER_EPOCH=18

# --- send case (the growth op) ---
#
# 30 client-to-client OOR sends per epoch, executed in 3 waves of 10:
# every client sends concurrently in each wave (concurrency spread across
# nodes, never stacked on one node: P11), each to a uniformly random other
# client. Amounts are uniform in [SEND_MIN,SEND_MAX] sat, above the 1000
# sat operator minimum with headroom for fees.
SEND_TOTAL=30
SEND_WAVES=3
SEND_MIN=25000
SEND_MAX=100000

# --- refresh case (v2.1: selective, wallet-realistic) ---
#
# Each epoch every client refreshes only the vtxos a real wallet would:
# those within REFRESH_MAX_REMAINING_BLOCKS of their batch expiry (1008
# blocks = one real week; 300 blocks = the last ~2 days), plus those whose
# OOR chain depth reached REFRESH_MAX_CHAIN_DEPTH, because a lineage that
# keeps growing eventually exceeds the operator's 25k vB cap and the vtxo
# becomes unspendable over OOR (seen live in v1 epoch 14 and v2 epoch 9+).
# A client with nothing eligible skips: recorded, not failed, excluded from
# the timing percentiles. Clients that do submit land in the same round.
REFRESH_JOIN_TIMEOUT=120
REFRESH_MAX_REMAINING_BLOCKS=300
REFRESH_MAX_CHAIN_DEPTH=6

# --- boarding (untimed prerequisite, recorded when it runs) ---
#
# Boards are a top-up, not a headline case: a client whose offchain
# balance sits below BOARD_FLOOR gets BOARD_AMOUNT sent to its boarding
# address and boards it before the timed cases start. Recorded as an
# optional per-epoch field so it renders as gaps in the series, not zeros.
# Operator caps raised for v2 (gen-compose passes the flags): max vtxo
# 4M, max user balance 8M, so a 2M board fits in one vtxo. Min vtxo 1000
# and min operator fee 1000 stay at defaults.
BOARD_FLOOR=400000
BOARD_AMOUNT=2000000

# --- timeouts ---
CASE_TIMEOUT=15m
SUITE_TIMEOUT=90m

# Stop the series at this many epochs; cron.sh removes its own crontab
# entry on reaching it. Raise and reinstall to continue.
MAX_EPOCHS=400

# Cases to run, in order.
CASES="send refresh"

# --- capital conservation ---
#
# Every sat entering the system arrives through a harness-made deposit to a
# boarding address, so total-deposited is exactly reconstructible: this seed
# plus BOARD_AMOUNT per board recorded in the series. Zero for v2: the
# network starts empty and every board from epoch 1 on is in the records.
# The invariant, verified exact on live v1 data before wiring:
#   deposited == clients_spendable + clients_pending_net + fees_extracted
DEPOSITED_BOOTSTRAP_SAT=0

# Operator tables whose exact row counts are recorded each snapshot: the
# ones the workload grows. Exact count(*), never pg_stat estimates (P4).
# selftest.sh asserts every one of these exists, so a rename in a future
# operator version fails loudly instead of recording null forever.
OPERATOR_COUNT_TABLES="vtxos rounds oor_sessions oor_checkpoints ledger_entries processed_messages indexer_vtxo_events indexer_receive_scripts round_client_registrations round_forfeit_infos"

# Wallet password shared by all regtest clients. Regtest-only funds; the
# creds dir is gitignored and the password is also written there for the
# auto-unlock mount.
WALLET_PASSWORD=wavebench-regtest
